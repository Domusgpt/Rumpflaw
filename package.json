{
  "name": "rumpflaw-site",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Rumpf Law, P.C. (Tuckerton / Little Egg Harbor Township, New Jersey) — static, GSAP scroll experience, deployed via GitHub Pages.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build.mjs",
    "build:preview": "SITE_ENV=preview node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "SITE_ENV=development node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test 'tests/unit/*.test.mjs' && node tests/e2e.mjs",
    "test:unit": "node --test 'tests/unit/*.test.mjs'",
    "test:e2e": "node tests/e2e.mjs",
    "visual": "node tests/visual.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "axe-core": "4.14.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  }
}
